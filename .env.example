# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@host-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://username:password@host.neon.tech/neondb?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# ── Groq (AI chatbot) ──────────────────────────────────────
GROQ_API_KEY=gsk-...

# ── Resend (transactional email) ─────────────────────────────
RESEND_API_KEY=re_...
ADMIN_EMAIL=admin@burtech.io

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
PORT=4000

# ── Frontend (Next.js public vars) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
